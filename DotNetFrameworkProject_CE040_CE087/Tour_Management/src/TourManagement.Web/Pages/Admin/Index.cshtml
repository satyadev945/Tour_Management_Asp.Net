@page
@model TourManagement.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>
<div class="row g-4 mt-2">
    <div class="col-md-4"><div class="card shadow-sm"><div class="card-body"><h5>Tours</h5><p class="display-6">@Model.TourCount</p></div></div></div>
    <div class="col-md-4"><div class="card shadow-sm"><div class="card-body"><h5>Bookings</h5><p class="display-6">@Model.BookingCount</p></div></div></div>
    <div class="col-md-4"><div class="card shadow-sm"><div class="card-body"><h5>Users</h5><p class="display-6">@Model.UserCount</p></div></div></div>
</div>
<div class="mt-4 d-flex gap-2">
    <a class="btn btn-primary" asp-page="/Tours/Create">Add Tour</a>
    <a class="btn btn-outline-primary" asp-page="/Bookings/Index">Manage Bookings</a>
    <a class="btn btn-outline-primary" asp-page="/Users/Index">Manage Users</a>
</div>
