@page "{id:int}"
@model TourManagement.Web.Pages.Bookings.DeleteModel
@if (Model.Booking is not null)
{
    <h1>Delete Booking</h1>
    <p>Delete booking for <strong>@Model.Booking.CustomerName</strong>?</p>
    <form method="post"><button type="submit" class="btn btn-danger">Delete</button></form>
}
