@page
@model TourManagement.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Create Booking";
}
<h1>Create Booking</h1>
<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6"><label asp-for="Booking.TourId" class="form-label"></label><select asp-for="Booking.TourId" asp-items="Model.TourOptions" class="form-select"></select></div>
    <div class="col-md-6"><label asp-for="Booking.CustomerName" class="form-label"></label><input asp-for="Booking.CustomerName" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Booking.Email" class="form-label"></label><input asp-for="Booking.Email" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Booking.City" class="form-label"></label><input asp-for="Booking.City" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Booking.PhoneNumber" class="form-label"></label><input asp-for="Booking.PhoneNumber" class="form-control" /></div>
    <div class="col-12"><button type="submit" class="btn btn-primary">Save</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
