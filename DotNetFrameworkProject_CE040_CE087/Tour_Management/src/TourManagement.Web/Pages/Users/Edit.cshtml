@page "{id:int}"
@model TourManagement.Web.Pages.Users.EditModel
<h1>Edit User</h1>
<form method="post" class="row g-3">
<div class="col-md-6"><label asp-for="EditUser.FirstName" class="form-label"></label><input asp-for="EditUser.FirstName" class="form-control" /></div>
<div class="col-md-6"><label asp-for="EditUser.LastName" class="form-label"></label><input asp-for="EditUser.LastName" class="form-control" /></div>
<div class="col-md-4"><label asp-for="EditUser.Gender" class="form-label"></label><input asp-for="EditUser.Gender" class="form-control" /></div>
<div class="col-md-4"><label asp-for="EditUser.DateOfBirth" class="form-label"></label><input asp-for="EditUser.DateOfBirth" class="form-control" /></div>
<div class="col-md-4"><label asp-for="EditUser.City" class="form-label"></label><input asp-for="EditUser.City" class="form-control" /></div>
<div class="col-md-6"><label asp-for="EditUser.Street" class="form-label"></label><input asp-for="EditUser.Street" class="form-control" /></div>
<div class="col-md-6"><label asp-for="EditUser.State" class="form-label"></label><input asp-for="EditUser.State" class="form-control" /></div>
<div class="col-12"><button type="submit" class="btn btn-primary">Update</button></div>
</form>
