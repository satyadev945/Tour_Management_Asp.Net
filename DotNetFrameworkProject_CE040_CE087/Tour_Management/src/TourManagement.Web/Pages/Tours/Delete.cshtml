@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}
@if (Model.Tour is not null)
{
    <h1>Delete Tour</h1>
    <p>Are you sure you want to delete <strong>@Model.Tour.Name</strong>?</p>
    <form method="post"><button type="submit" class="btn btn-danger">Delete</button> <a asp-page="Index" class="btn btn-secondary">Cancel</a></form>
}
