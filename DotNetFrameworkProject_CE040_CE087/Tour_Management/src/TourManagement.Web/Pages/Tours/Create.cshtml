@page
@model TourManagement.Web.Pages.Tours.CreateModel
@{
    ViewData["Title"] = "Create Tour";
}
<h1>Create Tour</h1>
<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6"><label asp-for="Tour.Name" class="form-label"></label><input asp-for="Tour.Name" class="form-control" /><span asp-validation-for="Tour.Name" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Tour.Place" class="form-label"></label><input asp-for="Tour.Place" class="form-control" /><span asp-validation-for="Tour.Place" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Tour.Days" class="form-label"></label><input asp-for="Tour.Days" class="form-control" /><span asp-validation-for="Tour.Days" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Tour.Price" class="form-label"></label><input asp-for="Tour.Price" class="form-control" /><span asp-validation-for="Tour.Price" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Tour.ImagePath" class="form-label"></label><input asp-for="Tour.ImagePath" class="form-control" /></div>
    <div class="col-12"><label asp-for="Tour.Locations" class="form-label"></label><input asp-for="Tour.Locations" class="form-control" /><span asp-validation-for="Tour.Locations" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="Tour.Description" class="form-label"></label><textarea asp-for="Tour.Description" class="form-control"></textarea></div>
    <div class="col-12"><button type="submit" class="btn btn-primary">Save</button> <a asp-page="Index" class="btn btn-secondary">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
