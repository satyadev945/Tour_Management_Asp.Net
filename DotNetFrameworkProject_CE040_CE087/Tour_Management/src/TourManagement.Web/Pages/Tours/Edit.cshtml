@page "{id:int}"
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}
<h1>Edit Tour</h1>
<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6"><label asp-for="Tour.Name" class="form-label"></label><input asp-for="Tour.Name" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Tour.Place" class="form-label"></label><input asp-for="Tour.Place" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Tour.Days" class="form-label"></label><input asp-for="Tour.Days" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Tour.Price" class="form-label"></label><input asp-for="Tour.Price" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Tour.ImagePath" class="form-label"></label><input asp-for="Tour.ImagePath" class="form-control" /></div>
    <div class="col-12"><label asp-for="Tour.Locations" class="form-label"></label><input asp-for="Tour.Locations" class="form-control" /></div>
    <div class="col-12"><label asp-for="Tour.Description" class="form-label"></label><textarea asp-for="Tour.Description" class="form-control"></textarea></div>
    <div class="col-12"><button type="submit" class="btn btn-primary">Update</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
