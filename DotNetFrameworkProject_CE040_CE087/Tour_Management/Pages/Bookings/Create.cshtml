@page
@model Tour_Management.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Create Booking";
}

<h1>Create Booking</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.TourId"></label>
        <select asp-for="Input.TourId" asp-items="Model.TourOptions" class="form-select"></select>
    </div>
    <div class="mb-3"><label asp-for="Input.CustomerName"></label><input asp-for="Input.CustomerName" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Input.Email"></label><input asp-for="Input.Email" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Input.Place"></label><input asp-for="Input.Place" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
