@page
@model Tour_Management.Pages.Bookings.IndexModel
@{
    ViewData["Title"] = "Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Bookings</h1>
    <a class="btn btn-success" asp-page="Create">Create Booking</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Tour</th>
            <th>Customer</th>
            <th>Email</th>
            <th>Place</th>
            <th>Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Bookings)
    {
        <tr>
            <td>@item.TourName</td>
            <td>@item.CustomerName</td>
            <td>@item.Email</td>
            <td>@item.Place</td>
            <td>@item.BookingDate.ToLocalTime()</td>
            <td>
                <a asp-page="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
