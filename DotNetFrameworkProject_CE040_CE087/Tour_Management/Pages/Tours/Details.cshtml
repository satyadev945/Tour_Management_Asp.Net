@page "{id:int}"
@model Tour_Management.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

@if (Model.Tour is null)
{
    <div class="alert alert-warning">Tour not found.</div>
}
else
{
    <h1>@Model.Tour.Name</h1>
    <dl class="row">
        <dt class="col-sm-3">Place</dt><dd class="col-sm-9">@Model.Tour.Place</dd>
        <dt class="col-sm-3">Days</dt><dd class="col-sm-9">@Model.Tour.Days</dd>
        <dt class="col-sm-3">Price</dt><dd class="col-sm-9">@Model.Tour.Price.ToString("C")</dd>
        <dt class="col-sm-3">Locations</dt><dd class="col-sm-9">@Model.Tour.Locations</dd>
        <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Tour.Description</dd>
    </dl>
    <a class="btn btn-primary" asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.Id">Book Tour</a>
}
