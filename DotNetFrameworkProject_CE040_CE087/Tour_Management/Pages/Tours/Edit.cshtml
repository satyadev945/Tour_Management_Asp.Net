@page "{id:int}"
@model Tour_Management.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>Edit Tour</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Input.Id" />
    <div class="mb-3"><label asp-for="Input.Name"></label><input asp-for="Input.Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Input.Place"></label><input asp-for="Input.Place" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Input.Days"></label><input asp-for="Input.Days" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Input.Price"></label><input asp-for="Input.Price" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Input.Locations"></label><input asp-for="Input.Locations" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Input.Description"></label><textarea asp-for="Input.Description" class="form-control"></textarea></div>
    <div class="mb-3"><label asp-for="Input.ImagePath"></label><input asp-for="Input.ImagePath" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Update</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
