@page "{id:int}"
@model Tour_Management.Pages.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

@if (Model.Tour is null)
{
    <div class="alert alert-warning">Tour not found.</div>
}
else
{
    <h1>Delete Tour</h1>
    <p>Are you sure you want to delete <strong>@Model.Tour.Name</strong>?</p>
    <form method="post">
        <input type="hidden" asp-for="Tour!.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
}
