<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tour Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Tour Management</a>
                <div class="navbar-nav">
                    <a class="nav-link" asp-page="/Tours/Index">Tours</a>
                    <a class="nav-link" asp-page="/Bookings/Index">Bookings</a>
                    <a class="nav-link" asp-page="/Profile/Index">Profile</a>
                    <a class="nav-link" asp-page="/Admin/Index">Admin</a>
                </div>
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-page="/Account/Login">Login</a>
                    <a class="nav-link" asp-page="/Account/Register">Register</a>
                </div>
            </div>
        </nav>
    </header>
    <main class="container py-4">
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
