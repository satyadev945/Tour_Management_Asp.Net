@page
@model TourManagement.Web.Pages.Users.LoginModel
@{
    ViewData["Title"] = "Login";
}

<h1>User Login</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="LoginViewModel.Email" class="control-label"></label>
                <input asp-for="LoginViewModel.Email" class="form-control" />
                <span asp-validation-for="LoginViewModel.Email" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="LoginViewModel.Password" class="control-label"></label>
                <input asp-for="LoginViewModel.Password" class="form-control" type="password" />
                <span asp-validation-for="LoginViewModel.Password" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Login" class="btn btn-primary" />
                <a asp-page="Register" class="btn btn-link">Register</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
